{
  "name": "Daily Weather Rain Alert",
  "nodes": [
    {
      "parameters": {},
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [0, 172],
      "id": "eed9e222-ea6a-4c08-8f4d-8ef813cc6ef3",
      "name": "When clicking ‘Execute workflow’"
    },
    {
      "parameters": {
        "url": "https://api.weatherapi.com/v1/current.json",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "key",
              "value": "YOUR_API_KEY"
            },
            {
              "name": "q",
              "value": "lahore"
            },
            {
              "name": "aqi",
              "value": "no"
            }
          ]
        }
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [208, 176],
      "id": "dea2f838-f9ce-41fd-857f-b6a7d8cc328e",
      "name": "HTTP Request"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 3
          },
          "conditions": [
            {
              "id": "9bd45ee4-ce1c-4acc-97b7-bec5d77e8c40",
              "leftValue": "={{ $json.current.condition.text }}",
              "rightValue": "Clear",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [416, 176],
      "id": "80f47025-b927-48d0-ad6f-a9a374540e78",
      "name": "If"
    },
    {
      "parameters": {
        "sendTo": "YOUR_EMAIL",
        "subject": "weather alert",
        "emailType": "text",
        "message": "=today, {{ $json.location.name }}\nweather is {{ $json.current.condition.text }}"
      },
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.2,
      "position": [672, 80],
      "id": "0126d00c-eaef-4921-ac3f-e4c934e43131",
      "name": "Send a message",
      "webhookId": "REMOVED_FOR_SECURITY",
      "credentials": {
        "gmailOAuth2": {
          "id": "REPLACE_WITH_YOUR_CREDENTIAL_ID",
          "name": "Gmail account"
        }
      }
    }
  ],
  "connections": {
    "When clicking ‘Execute workflow’": {
      "main": [
        [
          {
            "node": "HTTP Request",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "HTTP Request": {
      "main": [
        [
          {
            "node": "If",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "If": {
      "main": [
        [
          {
            "node": "Send a message",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false
}
